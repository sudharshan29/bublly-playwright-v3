{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "commonjs",
    "moduleResolution": "node",
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "outDir":           "dist",
    "baseUrl":          ".",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "scripts/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
